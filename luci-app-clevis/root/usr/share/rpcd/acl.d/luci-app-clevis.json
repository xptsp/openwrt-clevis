{
	"luci-app-clevis": {
		"description": "Grant UCI and Ubus access to Clevis monitoring tools",
		"read": {
			"uci": [ "clevis", "fstab" ],
			"ubus": {
				"clevis": [ "status", "mounts", "populate" ]
			}
		},
		"write": {
			"uci": [ "clevis", "fstab" ],
			"ubus": {
				"clevis": [ "populate", "unlock", "unlock_passphrase", "lock", "mount", "umount", "fstab_sync" ]
			}
		}
	}
}
