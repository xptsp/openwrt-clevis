#!/bin/sh /etc/rc.common

# Start late in the boot sequence after network, cryptsetup, and fstab subsystems are initialized
START=95
USE_PROCD=1

# Update the headers at the top of the file
EXTRA_COMMANDS="worker lock unlock"
EXTRA_HELP="        worker   Non-blocking worker for mounting encrypted LUKS partitions
        lock     Lock specified encrypted LUKS partition
        unlock   Unlock specified encrypted LUKS partition"

# Helper function to dynamically locate device path by UUID or LABEL without /dev/disk/by-uuid
find_device() {
	local uuid="$1"
	local label="$2"

	if [ -n "${uuid}" ]; then
		blkid | grep -i "UUID=\"${uuid}\"" | cut -d: -f1
	elif [ -n "${label}" ]; then
		blkid | grep -i "LABEL=\"${label}\"" | cut -d: -f1
	fi
}

# Helper function to extract Tang host targets straight from LUKS header slots metadata
extract_tang_from_luks() {
	local dev="$1"
	local url host

	[ -b "${dev}" ] || return 1

	# Query the metadata slot headers, pull the tang line, and strip out the url payload block
	url=$(clevis luks list -d "${dev}" 2>/dev/null | grep -i 'tang' | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')
	
	if [ -n "$url" ]; then
		# Strip protocol headers and port indicators (e.g., http://192.168.10.1:9090 -> 192.168.10.1)
		host=$(echo "$url" | sed -e 's/^[a-zA-Z]*:\/\///' -e 's/[:\/].*//')
		echo "$host"
		return 0
	fi
	return 1
}

# Run-once background task executed by procd worker instance
worker() {
	config_load clevis

	local net_timeout
	config_get network_timeout global network_timeout 0

	if [ "${network_timeout}" -gt 0 ]; then
		local tang_host=""
		
		# Inner callback to check configured drives and find the first real block device location
		find_and_extract_tang() {
			local cfg="$1"
			local enabled uuid label dev
			[ -n "${tang_host}" ] && return 0 # Skip if already found

			config_get_bool enabled "$cfg" enabled 0
			[ "$enabled" -eq 1 ] || return 0

			config_get uuid "$cfg" uuid
			config_get label "$cfg" label
			
			# Resolve the raw underlying block device string path using your type-safe blkid check
			dev=$(find_device "${uuid}" "${label}")
			if [ -n "${dev}" ] && [ -b "${dev}" ]; then
				tang_host=$(extract_tang_from_luks "${dev}")
			fi
		}
		config_foreach find_and_extract_tang drive

		# If an active ping target host signature is verified, monitor connectivity status loops
		if [ -n "${tang_host}" ]; then
			logger -t clevis "Waiting up to ${network_timeout}s for cryptographic host target '${tang_host}' to respond..."
			local count=0
			while ! ping -c 1 -W 1 "${tang_host}" >/dev/null 2>&1; do
				sleep 1
				count=$((count + 1))
				if [ "$count" -ge "${network_timeout}" ]; then
					logger -t clevis "Target host timeout reached. Proceeding with unlocking attempts..."
					break
				fi
			done
		fi
	fi

	# Proceed with standard initialization and decryption sweeps
	config_foreach process_drive drive
}

# Process each configured drive entry
process_drive() {
	local cfg="$1"
	local enabled uuid label mapper dev pre_mount post_mount

	config_get_bool enabled "$cfg" enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get uuid "$cfg" uuid
	config_get label "$cfg" label
	config_get mapper "$cfg" mapper
	
	# Dynamically extract 'pre_mount' options mirroring view definitions
	config_get pre_mount "$cfg" pre_mount ""
	config_get post_mount "$cfg" post_mount ""

	if [ -z "${mapper}" ]; then
		logger -t clevis "Error: 'mapper' name must be defined for config section '$cfg'"
		return 1
	fi

	dev=$(find_device "${uuid}" "${label}")

	if [ -z "${dev}" ] || [ ! -b "${dev}" ]; then
		logger -t clevis "Warning: Could not locate block device for configuration '$cfg' (UUID: ${uuid} / LABEL: ${label})"
		return 1
	fi

	if [ -b "/dev/mapper/${mapper}" ]; then
		logger -t clevis "Volume '${mapper}' is already unlocked."
		return 0
	fi

	logger -t clevis "Attempting automated Clevis unlock for ${dev} -> /dev/mapper/${mapper}"

	# Clear clean caches right before cryptsetup allocations to bypass the OOM Killer gate
	sync && echo 3 > /proc/sys/vm/drop_caches
	sleep 1

	# Execute Clevis wrapped in 'nice' to protect resource overhead stability bounds
	if nice -n 19 clevis luks unlock -d "${dev}" -n "${mapper}"; then
		logger -t clevis "Successfully unlocked ${dev} as /dev/mapper/${mapper}"
		
		# Aligned processing hook variable assignments
		if [ -n "${pre_mount}" ]; then
			logger -t clevis "Executing custom pre-mount hook for section '$cfg'..."
			( eval "${pre_mount}" )
		fi

		# Proactively tell blockd to check for new mountable devices
		/sbin/block mount

		if [ -n "${post_mount}" ]; then
			logger -t clevis "Executing custom post-unlock hook for section '$cfg'..."
			( eval "${post_mount}" )
		fi
	else
		logger -t clevis "Error: Clevis auto-unlock failed for device ${dev}"
	fi
}

unlock() {
	local target="$1"
	config_load clevis

	if [ -z "$target" ]; then
		logger -t clevis "Error: 'unlock' command requires a specific section ID or mapper name argument."
		return 1
	fi

	local found=0
	check_and_unlock() {
		local cfg="$1" cm
		config_get cm "$cfg" mapper
		if [ "$cfg" = "$target" ] || [ "$cm" = "$target" ]; then
			found=1
			process_drive "$cfg"
		fi
	}
	config_foreach check_and_unlock drive

	if [ "$found" -eq 0 ]; then
		logger -t clevis "Warning: No matching encryption configuration profile found for target: $target"
		return 1
	fi
}

close_drive() {
	local cfg="$1"
	local enabled mapper pre_unmount post_unmount mount_path

	config_get_bool enabled "$cfg" enabled 0
	config_get mapper "$cfg" mapper
	
	# Dynamically extract user teardown task hook strings directly out of UCI database
	config_get pre_unmount "$cfg" pre_unmount ""
	config_get post_unmount "$cfg" post_unmount ""

	if [ -b "/dev/mapper/${mapper}" ]; then
		# Locate active filesystem target node path safely via standard mount sweeps
		mount_path=$(mount | grep "/dev/mapper/${mapper} " | awk '{print $3}')
		
		# 1. Execute Safe Pre-Unmount Task Hooks (e.g. Stop Samba, NFS, Docker Containers)
		if [ -n "${pre_unmount}" ] && [ -n "${mount_path}" ]; then
			logger -t clevis "Executing custom pre-unmount hook for section '${cfg}'..."
			( eval "${pre_unmount}" )
			sleep 1
		fi

		# 2. Execute a Clean, Safe System Unmount in Reverse Order (Handles nested secondary child drives safely)
		if [ -n "${mount_path}" ] && mountpoint -q "${mount_path}"; then
			logger -t clevis "Detaching active filesystem safely from ${mount_path}..."
			
			# FIX: Grep for both the mapper source node AND any partitions mounted inside the target path directory tree
			# Using sort -r guarantees that /mnt/secure_storage/boot is unmounted BEFORE /mnt/secure_storage!
			mount | grep -E "/dev/mapper/${mapper}|on ${mount_path}/" | sort -r | while read -r dev misc dir misc_rest; do 
				logger -t clevis "Sequential teardown: Unmounting directory node ${dir}"
				umount "${dir}"
			done
			
			# Final safety sweep for the root mount path itself
			if mountpoint -q "${mount_path}"; then
				umount "${mount_path}"
			fi

			# Check if any stubborn mount references are STILL left behind in the table
			if mount | grep -q "/dev/mapper/${mapper}"; then
				logger -t clevis "Error: Failed to unmount /dev/mapper/${mapper} safely. Device remains busy."
				return 1
			fi
			sleep 1
		fi

		# 3. Execute Custom Post-Unmount Task Hooks
		if [ -n "${post_unmount}" ]; then
			logger -t clevis "Executing custom post-unmount hook for section '${cfg}'..."
			( eval "${post_unmount}" )
			sleep 1
		fi

		# 4. Safely Close and Seal the Cryptographic LUKS Layer
		logger -t clevis "Closing cryptographic mapper layer safely: ${mapper}"
		if cryptsetup close "${mapper}"; then
			return 0
		else
			logger -t clevis "Error: Cryptsetup close failed for mapper container layer: ${mapper}"
			return 1
		fi
	fi
}

# Helper function to lock a single encrypted encrypted target
lock() {
	local target="$1"
	config_load clevis

	if [ -z "$target" ]; then
		logger -t clevis "Error: 'lock' command requires a specific section ID or mapper name argument."
		return 1
	fi

	# Search the config definitions to find a match for either the section ID or the explicit mapper moniker
	local found=0
	check_and_lock() {
		local cfg="$1" cm
		config_get cm "$cfg" mapper
		if [ "$cfg" = "$target" ] || [ "$cm" = "$target" ]; then
			found=1
			close_drive "$cfg"
		fi
	}
	config_foreach check_and_lock drive

	if [ "$found" -eq 0 ]; then
		logger -t clevis "Warning: No matching encryption configuration profile found for target: $target"
		return 1
	fi
}

start_service() {
	# Check if the global daemon hook configurations are fully mapped
	config_load clevis

	procd_open_instance "unlocker"
	# Execute via the standard system wrapper shell to allow proper forking environments
	procd_set_param command /bin/sh -c "/etc/init.d/clevis worker"
	procd_set_param stdout 1
	procd_set_param stderr 1
	# Ensures the daemon frees system memory loops if it encounters a critical thread drop
	procd_set_param respawn 0 0 0
	procd_close_instance
}

stop_service() {
	config_load clevis
	config_foreach close_drive drive
}
