#!/bin/sh /etc/rc.common

# Start late in the boot sequence after network, cryptsetup, and fstab subsystems are initialized
START=95
USE_PROCD=1

EXTRA_COMMANDS="worker"
EXTRA_HELP="        worker   Non-blocking worker for mounting encrypted LUKS partitions"

# Helper function to dynamically locate device path by UUID or LABEL without /dev/disk/by-uuid
find_device() {
	local uuid="$1"
	local label="$2"

	if [ -n "$uuid" ]; then
		blkid | grep -i "UUID=\"$uuid\"" | cut -d: -f1
	elif [ -n "$label" ]; then
		blkid | grep -i "LABEL=\"$label\"" | cut -d: -f1
	fi
}

# Run-once background task executed by procd worker instance
worker() {
	config_load clevis

	# Simple network verification check (only block-waits if a Tang server binding might be needed)
	local net_timeout
	config_get net_timeout global network_timeout 0
	if [ "$net_timeout" -gt 0 ]; then
		logger -t clevis "Waiting up to ${net_timeout}s for network interface to establish connectivity..."
		local count=0
		while ! ping -c 1 -W 1 8.8.8.8 >/dev/null 2>&1; do
			sleep 1
			count=$((count + 1))
			if [ "$count" -ge "$net_timeout" ]; then
				logger -t clevis "Network timeout reached. Proceeding with unlocking attempts..."
				break
			fi
		done
	fi

	# Iterate over all drive config stanzas
	config_foreach process_drive drive
}

# Process each configured drive entry
process_drive() {
	local cfg="$1"
	local enabled uuid label mapper dev

	config_get_bool enabled "$cfg" enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get uuid "$cfg" uuid
	config_get label "$cfg" label
	config_get mapper "$cfg" mapper

	if [ -z "$mapper" ]; then
		logger -t clevis "Error: 'mapper' name must be defined for config section '$cfg'"
		return 1
	fi

	dev=$(find_device "$uuid" "$label")

	if [ -z "$dev" ] || [ ! -b "$dev" ]; then
		logger -t clevis "Warning: Could not locate block device for configuration '$cfg' (UUID: $uuid / LABEL: $label)"
		return 1
	fi

	if [ -b "/dev/mapper/$mapper" ]; then
		logger -t clevis "Volume '$mapper' is already unlocked."
		return 0
	fi

	logger -t clevis "Attempting automated Clevis unlock for $dev -> /dev/mapper/$mapper"

	if clevis luks unlock -d "$dev" -n "$mapper"; then
		logger -t clevis "Successfully unlocked $dev as /dev/mapper/$mapper"
		
		# Proactively tell blockd to check for new mountable devices
		/sbin/block mount
	else
		logger -t clevis "Error: Clevis auto-unlock failed for device $dev"
	fi
}

close_drive() {
	local cfg="$1"
	local enabled mapper

	config_get_bool enabled "$cfg" enabled 0
	config_get mapper "$cfg" mapper

	if [ -b "/dev/mapper/$mapper" ]; then
		logger -t clevis "Closing cryptographic mapper layer: $mapper"
		cryptsetup close "$mapper"
	fi
}

start_service() {
	procd_open_instance "unlocker"
	procd_set_param command /etc/init.d/clevis worker
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	config_load clevis
	config_foreach close_drive drive
}
