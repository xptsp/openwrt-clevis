config global 'global'
	# Global timeout to wait for a network connection (only needed if using a Tang server)
	option network_timeout '30'

config drive
	option enabled '1'
	option uuid '8423591b-6631-4857-bb68-0959037c3fef'
	#option label ''
	option mapper 'secure_data'

	# Runs BEFORE mounting encrypted partition (e.g. mount or run a selective filesystem check)
	#option pre_mount 'fsck.ext4 -y /dev/mapper/$mapper && mount /dev/mapper/$mapper /mnt/secure_data'

	# Runs AFTER mounting encrypted partition (e.g. starting docker)
	#option post_mount 'service docker start'

config drive
	option enabled '0'
	#option uuid ''
	option label 'backup_vault'
	option mapper 'backup_storage'
